{
  "config": {
    "step": {
      "user": {
        "title": "Mazda 6e & CX-6e",
        "description": "Set up your Mazda 6e or CX-6e account (the MAZDA 6e & CX-6e app account). Sign in with the email and password of the app, or request a verification code by email.",
        "data": {
          "login_method": "Login method"
        },
        "data_description": {
          "login_method": "Email and password signs in directly; email verification code sends a one-time code to the account email."
        }
      },
      "email_password": {
        "title": "Email and password",
        "description": "Select the sales country registered in the Mazda app and enter the account credentials. Home Assistant stores the session tokens, never the password.",
        "data": {
          "country": "Sales country",
          "email": "Email",
          "password": "Password"
        },
        "data_description": {
          "country": "Sales country of the account, for example Spain. It is sent as selectcountry and salesCountry.",
          "email": "Email used in the Mazda app. It is encrypted before it is sent.",
          "password": "Password used in the Mazda app. It is encrypted before it is sent and is never stored."
        }
      },
      "intl_email": {
        "title": "Email login",
        "description": "Select the sales country registered in the Mazda app and the account email. Home Assistant will request a verification code.",
        "data": {
          "country": "Sales country",
          "email": "Email"
        },
        "data_description": {
          "country": "Sales country of the account, for example Spain. It is sent as selectcountry and salesCountry.",
          "email": "Email used in the Mazda app. It is encrypted before it is sent."
        }
      },
      "intl_email_code": {
        "title": "Email verification code",
        "description": "Enter the verification code that was sent to the email address.",
        "data": {
          "auth_code": "Verification code"
        },
        "data_description": {
          "auth_code": "Numeric code from the email. It expires quickly; request a new one if it is rejected."
        }
      }
    },
    "error": {
      "invalid_auth": "Authentication failed.",
      "cannot_connect": "Could not reach the Mazda API.",
