  "options": {
    "step": {
      "init": {
        "title": "Mazda 6e & CX-6e options",
        "data": {
          "scan_interval": "Scan interval (seconds)",
          "control_pin": "Remote control PIN",
          "enable_api_logging": "Log redacted API traffic",
          "enable_mqtt_controls": "Enable experimental remote controls for MQTT vehicles",
          "os_version": "Declared Android version (diagnostic)",
          "environment": "Regional environment (diagnostic)"
        },
        "description": "Tune polling and diagnostics. The control PIN enables signed remote commands; the diagnostic options change how the API sees the client and should only be touched while troubleshooting.",
        "data_description": {
          "scan_interval": "How often Home Assistant polls the vehicle when no MQTT telemetry is available, in seconds (30-3600).",
          "control_pin": "Remote-control PIN from the Mazda app. Required to lock/unlock, move the windows or open the trunk; it is exchanged for a token that expires periodically and is asked for again when that happens.",
          "enable_api_logging": "Write every API request and response to the Home Assistant log, with tokens, keys, VIN, email, PIN and serial number redacted. Enable only while troubleshooting.",
          "enable_mqtt_controls": "Allow remote commands for MQTT-backed vehicles. Experimental: MQTT command sending is not verified yet.",
          "os_version": "Android version declared in the x-os-version header. The default (9) matches the verified Changan capture; change it only to diagnose requests rejected by the gateway.",
          "environment": "Regional gateway set used for the Mazda API. EU production by default; preproduction targets the UAT gateways."
        }
      }
    }
